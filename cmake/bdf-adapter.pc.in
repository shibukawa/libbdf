prefix=${pcfiledir}/@BDF_PC_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: bdf-@BDF_ADAPTER_NAME@
Description: BDF documents drawn with @BDF_ADAPTER_NAME@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires: bdf @BDF_ADAPTER_REQUIRES@
Libs: -L${libdir} -lbdf_@BDF_ADAPTER_NAME@
Cflags: -I${includedir}
