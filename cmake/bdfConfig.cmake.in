@PACKAGE_INIT@

# What the adapters this package was built with are linked with.
include(CMakeFindDependencyMacro)
if("@BDF_CAIRO@")
  find_dependency(PkgConfig)
  pkg_check_modules(BDF_CAIRO_DEP REQUIRED IMPORTED_TARGET cairo)
endif()

if("@BDF_QT@")
  find_dependency(@BDF_QT_PACKAGE@ COMPONENTS Gui)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/bdfTargets.cmake")

check_required_components(bdf)
